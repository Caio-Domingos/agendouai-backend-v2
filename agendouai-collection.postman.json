            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/{{apiPrefix}}/auth/refresh", "host": [ "{{baseUrl}}" ], "path": [ "{{apiPrefix}}", "auth", "refresh" ] }
