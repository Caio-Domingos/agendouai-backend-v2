          "name": "Login",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/{{apiPrefix}}/auth/login", "host": [ "{{baseUrl}}" ], "path": [ "{{apiPrefix}}", "auth", "login" ] }
          }
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"\",\n  \"password\": \"\",\n  \"name\": \"\"\n}" },
            "url": { "raw": "{{baseUrl}}/{{apiPrefix}}/auth/register", "host": [ "{{baseUrl}}" ], "path": [ "{{apiPrefix}}", "auth", "register" ] }
