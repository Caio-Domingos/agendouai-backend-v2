	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Extrai os tokens e dados do response",
									"const data = pm.response.json().data;",
									"",
									"if (data && data.accessToken && data.refreshToken) {",
									"    pm.environment.set(\"jwtToken\", data.accessToken);",
									"    pm.environment.set(\"refreshToken\", data.refreshToken);",
									"}"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/{{apiPrefix}}/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"{{apiPrefix}}",
								"auth",
								"login"
							]
						}
					},
					"response": []
				},
